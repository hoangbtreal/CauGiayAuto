# Environment Variables — Frontend Gara CRM
# Sao chép file này thành .env.local và điền giá trị thật
# Không commit .env.local vào git

# ERPNext backend
VITE_ERPNEXT_URL=http://localhost:8080

# Chatwoot (lấy API token trong Chatwoot > Profile Settings > Access Token)
VITE_CHATWOOT_URL=http://localhost:3000
VITE_CHATWOOT_API_TOKEN=
VITE_CHATWOOT_ACCOUNT_ID=1
