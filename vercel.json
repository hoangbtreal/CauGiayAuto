{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "dist": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/erpnext/(.*)",
      "dest": "https://deputize-revert-latch.ngrok-free.dev/erpnext/$1"
    },
    {
      "src": "/chatwoot/(.*)",
      "dest": "https://deputize-revert-latch.ngrok-free.dev/chatwoot/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" }
      ]
    }
  ]
}
